# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- TopstepX / ProjectX Gateway API ---
# Abonnement API requis (~29$/mois) : https://dashboard.projectx.com
PROJECTX_BASE_URL=https://api.topstepx.com
PROJECTX_USERNAME=votre_username
PROJECTX_API_KEY=votre_cle_api
# ID du compte Topstep (évaluation ou financé). Laissez vide pour
# sélectionner automatiquement le premier compte actif au démarrage.
PROJECTX_ACCOUNT_ID=

# --- TradingView webhook ---
# Secret partagé : mettez la même valeur dans le JSON de votre alerte TradingView.
WEBHOOK_SECRET=changez-moi

# --- Telegram (validation manuelle) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Règles de risque Topstep ---
# Perte journalière max en USD (ex: 1000 pour un compte 50K)
RISK_MAX_DAILY_LOSS=1000
# Taille max d'une position (contrats)
RISK_MAX_POSITION_SIZE=2
# Nombre max de positions ouvertes simultanément
RISK_MAX_OPEN_POSITIONS=1
# Délai d'expiration d'un signal non validé (secondes)
APPROVAL_TIMEOUT_SECONDS=300
